<!DOCTYPE STYLESHEET PUBLIC "-//SYNEX INFORMATION AB//DTD STYLESHEET EXPLORER//EN">

<STYLESHEET NAME="JGoethe">

<STYLE TAG="TEXT">
<FONT-FAMILY V="Times New Roman">
<SPC-LEFT V="5">
<BREAK-BEFORE>
<BREAK-AFTER>
</STYLE>

<STYLE TAG="CELL">
<LEADING V=1>
<SPC-ABOVE V="7">
<SPC-LEFT V="5">
<SPC-INDENT V="0">
<SPC-RIGHT V="7">
<SPC-BELOW V="7">
<PAGE-COLOR V="silver">
<TABLE V=CELL>
</STYLE>

<STYLE TAG="SP,P">
<SPC-LEFT V="20">
<BREAK-AFTER>
</STYLE>

<STYLE TAG="P">
<BREAK-BEFORE>
<BREAK-AFTER>
<BEFORE>
<FONT-COLOR V="red">
<BREAK-BEFORE>
<BREAK-AFTER>
</BEFORE>

<QUAL-STYLE QUAL="[rend]=&Q;BinnenTrennZeichen&Q;">
<JUSTIFY V=Center>
<BREAK-BEFORE>
<BREAK-AFTER>
</QUAL-STYLE>

<QUAL-STYLE QUAL="[rend]=&Q;ProsaMitErsteinzug&Q;">
<SPC-INDENT V="10">
<BREAK-BEFORE>
<BREAK-AFTER>
</QUAL-STYLE>

<QUAL-STYLE QUAL="[rend]=&Q;ErlaeuterungenKlein&Q;">
<FONT-SIZE V=8>
<BREAK-BEFORE>
<BREAK-AFTER>
</QUAL-STYLE>

<QUAL-STYLE QUAL="[rend]=&Q;Absatzhaengend&Q;">
<SPC-LEFT V="10">
<SPC-INDENT V="-10">
<BREAK-BEFORE>
<BREAK-AFTER>
</QUAL-STYLE>

<QUAL-STYLE QUAL="[rend]=&Q;Liste&Q;">
<SPC-LEFT V="10">
<SPC-INDENT V="-6">
<BREAK-BEFORE>
<BREAK-AFTER>
<A-TEXT V='&#149;   '>
<BEFORE>
<BREAK-BEFORE>
<BREAK-AFTER>
</BEFORE>
</QUAL-STYLE>

<QUAL-STYLE QUAL="par=SP">
<SPC-LEFT V="15">
<SPC-INDENT V="-30">
<BREAK-BEFORE>
<BREAK-AFTER>
</QUAL-STYLE>
</STYLE>

<STYLE TAG="SEG">

<QUAL-STYLE QUAL="[type]=&Q;Fremde Hand&Q;">
<FONT-SIZE V=8>
<BREAK-BEFORE>
<BREAK-AFTER>
</QUAL-STYLE>
</STYLE>

<STYLE TAG="XREF,#SGML">
</STYLE>

<STYLE TAG="#SGML">
</STYLE>

<STYLE TAG="PB">
<A-TEXT V=' [\att(n)] '>
<BEFORE>
<FONT-SIZE V=8>
<FONT-COLOR V="maroon">
<BREAK-BEFORE>
<BREAK-AFTER>
</BEFORE>
</STYLE>

<STYLE TAG="TITLESTMT,TITLE">
<FONT-SIZE V=16>
<JUSTIFY V=Center>
<BREAK-BEFORE>
<BREAK-AFTER>
<VISIBLE V=Show>
</STYLE>

<STYLE TAG="TITLE">
<FONT-FAMILY V="Times New Roman">
<FONT-SLANT V=Emphas>
<VISIBLE V=Show>
</STYLE>

<STYLE TAG="SPEAKER">
<FONT-SIZE V=9>
<SPC-LEFT V="0">
<SPC-INDENT V="8">
</STYLE>

<STYLE TAG="RESPSTMT">
<FONT-FAMILY V="Times New Roman">
<FONT-SIZE V=10>
<JUSTIFY V=Center>
<BREAK-BEFORE>
<BREAK-AFTER>
<VISIBLE V=Show>
</STYLE>

<STYLE TAG="BODY">
<FONT-FAMILY V="Times New Roman">
<FONT-SIZE V=10>
<BREAK-BEFORE>
<BREAK-AFTER>
</STYLE>

<STYLE TAG="EMPH">
<FONT-WEIGHT V=Bold>
</STYLE>

<STYLE TAG="FIGURE">

<QUAL-STYLE QUAL="[entity]=FFF7">
<JUSTIFY V=Right>
<BREAK-BEFORE>
<BREAK-AFTER>
</QUAL-STYLE>
</STYLE>

<STYLE TAG="MILESTONE">
</STYLE>

<STYLE TAG="LG">
<SPC-ABOVE V="5">
<SPC-BELOW V="5">
<BREAK-BEFORE>
<BREAK-AFTER>
<BEFORE>
<FONT-COLOR V="red">
<BREAK-BEFORE>
<BREAK-AFTER>
</BEFORE>
</STYLE>

<STYLE TAG="NOTE">
<ICON V="document">
</STYLE>

<STYLE TAG="XREF">
<FONT-COLOR V="maroon">
<LINKSRC V=Suppress>

<QUAL-STYLE QUAL="par=CELL and not (child=FIGURE)">
<SPC-LEFT V="6">
<SPC-INDENT V="-6">
<BREAK-BEFORE>
<BREAK-AFTER>
<A-TEXT V='&#149;   '>
<BEFORE>
<BREAK-BEFORE>
<BREAK-AFTER>
</BEFORE>
</QUAL-STYLE>
</STYLE>

<STYLE TAG="TABLE">
<SPC-ABOVE V="10">
<SPC-BELOW V="10">
<BREAK-BEFORE>
<BREAK-AFTER>
<PAGE-COLOR V="silver">
<TABLE V=TBL-NL>
</STYLE>

<STYLE TAG="TEIHEADER">
<BREAK-BEFORE>
<BREAK-AFTER>
<VISIBLE V=Hide>
</STYLE>

<STYLE TAG="ANCHOR">
<VISIBLE V=Hide>
</STYLE>

<STYLE TAG="ROW">
<BREAK-BEFORE>
<BREAK-AFTER>
<PAGE-COLOR V="silver">
<TABLE V=ROW>
</STYLE>

<STYLE TAG="HEAD,NAME">
<FONT-SIZE V=9>
</STYLE>

<STYLE TAG="NAME">
</STYLE>

<STYLE TAG="CELL,HI">
<FONT-SIZE V=10>
</STYLE>

<STYLE TAG="HI">
<FONT-SLANT V=Italic>
</STYLE>

<STYLE TAG="SP,P,STAGE">
<SPC-LEFT V="20">
</STYLE>

<STYLE TAG="STAGE">
<FONT-SLANT V=Italic>
</STYLE>

<STYLE TAG="L">
<BREAK-AFTER>
<A-TEXT V='\ifatt(n) \att(n)\tab\else\tab'>
<BEFORE>
<FONT-SIZE V=5>
<BREAK-BEFORE>
<BREAK-AFTER>
</BEFORE>

<QUAL-STYLE QUAL="[rend]=Bibelvers">
<BREAK-BEFORE>
<BREAK-AFTER>
<A-TEXT V=' \att(n).'>
<BEFORE>
<BREAK-BEFORE>
<BREAK-AFTER>
</BEFORE>
</QUAL-STYLE>
</STYLE>

<STYLE TAG="DIV6,HEAD">
<FONT-SLANT V=Italic>
<SPC-ABOVE V="10">
<SPC-BELOW V="7">
<BREAK-BEFORE>
<BREAK-AFTER>
</STYLE>

<STYLE TAG="DIV5,HEAD">
<FONT-FAMILY V="Times New Roman">
<FONT-SIZE V=12>
<FONT-WEIGHT V=Medium>
<SPC-ABOVE V="5">
<BREAK-BEFORE>
<BREAK-AFTER>
</STYLE>

<STYLE TAG="DIV4,HEAD">
<FONT-SIZE V=13>
<FONT-SLANT V=Emphas>
<FONT-WEIGHT V=Medium>
<SPC-ABOVE V="10">
<BREAK-BEFORE>
<BREAK-AFTER>
</STYLE>

<STYLE TAG="DIV3,HEAD">
<FONT-SIZE V=13>
<FONT-WEIGHT V=Bold>
<SPC-ABOVE V="12">
<BREAK-BEFORE>
<BREAK-AFTER>
</STYLE>

<STYLE TAG="DIV2,HEAD">
<FONT-SIZE V=14>
<SPC-ABOVE V="15">
<BREAK-BEFORE>
<BREAK-AFTER>
</STYLE>

<STYLE TAG="DIV1,HEAD">
<FONT-SIZE V=15>
<SPC-ABOVE V="18">
<BREAK-BEFORE>
<BREAK-AFTER>
</STYLE>

<STYLE TAG="P,XREF,FIGURE,#GIF">
<JUSTIFY V=Right>
<BREAK-BEFORE>
<BREAK-AFTER>
</STYLE>

<STYLE TAG="FIGURE,#GIF">

<QUAL-STYLE QUAL="[entity]=PFEILRE">
<JUSTIFY V=Right>
<BREAK-BEFORE>
<BREAK-AFTER>
</QUAL-STYLE>
</STYLE>

<STYLE TAG="#GIF">
</STYLE>

</STYLESHEET>
