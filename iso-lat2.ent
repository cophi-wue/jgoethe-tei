<!-- Character entity set. Typical invocation:
     <!ENTITY % ISOlat2 PUBLIC
       "ISO 8879-1986//ENTITIES Added Latin 2//EN">
     %ISOlat2;
-->
<!ENTITY abreve SDATA "ă"--=small a, breve-->
<!ENTITY Abreve SDATA "Ă"--=capital A, breve-->
<!ENTITY amacr  SDATA "ā"--=small a, macron-->
<!ENTITY Amacr  SDATA "Ā"--=capital A, macron-->
<!ENTITY aogon  SDATA "ą"--=small a, ogonek-->
<!ENTITY Aogon  SDATA "Ą"--=capital A, ogonek-->
<!ENTITY cacute SDATA "ć"--=small c, acute accent-->
<!ENTITY Cacute SDATA "Ć"--=capital C, acute accent-->
<!ENTITY ccaron SDATA "č"--=small c, caron-->
<!ENTITY Ccaron SDATA "Č"--=capital C, caron-->
<!ENTITY ccirc  SDATA "ĉ"--=small c, circumflex accent-->
<!ENTITY Ccirc  SDATA "Ĉ"--=capital C, circumflex accent-->
<!ENTITY cdot   SDATA "ċ"--=small c, dot above-->
<!ENTITY Cdot   SDATA "Ċ"--=capital C, dot above-->
<!ENTITY dcaron SDATA "ď"--=small d, caron-->
<!ENTITY Dcaron SDATA "Ď"--=capital D, caron-->
<!ENTITY dstrok SDATA "đ"--=small d, stroke-->
<!ENTITY Dstrok SDATA "Đ"--=capital D, stroke-->
<!ENTITY ecaron SDATA "ě"--=small e, caron-->
<!ENTITY Ecaron SDATA "Ě"--=capital E, caron-->
<!ENTITY edot   SDATA "ė"--=small e, dot above-->
<!ENTITY Edot   SDATA "Ė"--=capital E, dot above-->
<!ENTITY emacr  SDATA "ē"--=small e, macron-->
<!ENTITY Emacr  SDATA "Ē"--=capital E, macron-->
<!ENTITY eogon  SDATA "ę"--=small e, ogonek-->
<!ENTITY Eogon  SDATA "Ę"--=capital E, ogonek-->
<!ENTITY gacute SDATA "ǵ"--=small g, acute accent-->
<!ENTITY gbreve SDATA "ğ"--=small g, breve-->
<!ENTITY Gbreve SDATA "Ğ"--=capital G, breve-->
<!ENTITY Gcedil SDATA "Ģ"--=capital G, cedilla-->
<!ENTITY gcirc  SDATA "ĝ"--=small g, circumflex accent-->
<!ENTITY Gcirc  SDATA "Ĝ"--=capital G, circumflex accent-->
<!ENTITY gdot   SDATA "ġ"--=small g, dot above-->
<!ENTITY Gdot   SDATA "Ġ"--=capital G, dot above-->
<!ENTITY hcirc  SDATA "ĥ"--=small h, circumflex accent-->
<!ENTITY Hcirc  SDATA "Ĥ"--=capital H, circumflex accent-->
<!ENTITY hstrok SDATA "ħ"--=small h, stroke-->
<!ENTITY Hstrok SDATA "Ħ"--=capital H, stroke-->
<!ENTITY Idot   SDATA "İ"--=capital I, dot above-->
<!ENTITY Imacr  SDATA "Ī"--=capital I, macron-->
<!ENTITY imacr  SDATA "ī"--=small i, macron-->
<!ENTITY ijlig  SDATA "ĳ"--=small ij ligature-->
<!ENTITY IJlig  SDATA "Ĳ"--=capital IJ ligature-->
<!ENTITY inodot SDATA "ı"--=small i without dot-->
<!ENTITY iogon  SDATA "į"--=small i, ogonek-->
<!ENTITY Iogon  SDATA "Į"--=capital I, ogonek-->
<!ENTITY itilde SDATA "ĩ"--=small i, tilde-->
<!ENTITY Itilde SDATA "Ĩ"--=capital I, tilde-->
<!ENTITY jcirc  SDATA "ĵ"--=small j, circumflex accent-->
<!ENTITY Jcirc  SDATA "Ĵ"--=capital J, circumflex accent-->
<!ENTITY kcedil SDATA "ķ"--=small k, cedilla-->
<!ENTITY Kcedil SDATA "Ķ"--=capital K, cedilla-->
<!ENTITY kgreen SDATA "ĸ"--=small k, Greenlandic-->
<!ENTITY lacute SDATA "ĺ"--=small l, acute accent-->
<!ENTITY Lacute SDATA "Ĺ"--=capital L, acute accent-->
<!ENTITY lcaron SDATA "ľ"--=small l, caron-->
<!ENTITY Lcaron SDATA "Ľ"--=capital L, caron-->
<!ENTITY lcedil SDATA "ļ"--=small l, cedilla-->
<!ENTITY Lcedil SDATA "Ļ"--=capital L, cedilla-->
<!ENTITY lmidot SDATA "ŀ"--=small l, middle dot-->
<!ENTITY Lmidot SDATA "Ŀ"--=capital L, middle dot-->
<!ENTITY lstrok SDATA "ł"--=small l, stroke-->
<!ENTITY Lstrok SDATA "Ł"--=capital L, stroke-->
<!ENTITY nacute SDATA "ń"--=small n, acute accent-->
<!ENTITY Nacute SDATA "Ń"--=capital N, acute accent-->
<!ENTITY eng    SDATA "ŋ"--=small eng, Lapp-->
<!ENTITY ENG    SDATA "Ŋ"--=capital ENG, Lapp-->
<!ENTITY napos  SDATA "ŉ"--=small n, apostrophe-->
<!ENTITY ncaron SDATA "ň"--=small n, caron-->
<!ENTITY Ncaron SDATA "Ň"--=capital N, caron-->
<!ENTITY ncedil SDATA "ņ"--=small n, cedilla-->
<!ENTITY Ncedil SDATA "Ņ"--=capital N, cedilla-->
<!ENTITY odblac SDATA "ő"--=small o, double acute accent-->
<!ENTITY Odblac SDATA "Ő"--=capital O, double acute accent-->
<!ENTITY Omacr  SDATA "Ō"--=capital O, macron-->
<!ENTITY omacr  SDATA "ō"--=small o, macron-->
<!ENTITY oelig  SDATA "œ"--=small oe ligature-->
<!ENTITY OElig  SDATA "Œ"--=capital OE ligature-->
<!ENTITY racute SDATA "ŕ"--=small r, acute accent-->
<!ENTITY Racute SDATA "Ŕ"--=capital R, acute accent-->
<!ENTITY rcaron SDATA "ř"--=small r, caron-->
<!ENTITY Rcaron SDATA "Ř"--=capital R, caron-->
<!ENTITY rcedil SDATA "ŗ"--=small r, cedilla-->
<!ENTITY Rcedil SDATA "Ŗ"--=capital R, cedilla-->
<!ENTITY sacute SDATA "ś"--=small s, acute accent-->
<!ENTITY Sacute SDATA "Ś"--=capital S, acute accent-->
<!ENTITY scaron SDATA "š"--=small s, caron-->
<!ENTITY Scaron SDATA "Š"--=capital S, caron-->
<!ENTITY scedil SDATA "ş"--=small s, cedilla-->
<!ENTITY Scedil SDATA "Ş"--=capital S, cedilla-->
<!ENTITY scirc  SDATA "ŝ"--=small s, circumflex accent-->
<!ENTITY Scirc  SDATA "Ŝ"--=capital S, circumflex accent-->
<!ENTITY tcaron SDATA "ť"--=small t, caron-->
<!ENTITY Tcaron SDATA "Ť"--=capital T, caron-->
<!ENTITY tcedil SDATA "ţ"--=small t, cedilla-->
<!ENTITY Tcedil SDATA "Ţ"--=capital T, cedilla-->
<!ENTITY tstrok SDATA "ŧ"--=small t, stroke-->
<!ENTITY Tstrok SDATA "Ŧ"--=capital T, stroke-->
<!ENTITY ubreve SDATA "ŭ"--=small u, breve-->
<!ENTITY Ubreve SDATA "Ŭ"--=capital U, breve-->
<!ENTITY udblac SDATA "ű"--=small u, double acute accent-->
<!ENTITY Udblac SDATA "Ű"--=capital U, double acute accent-->
<!ENTITY umacr  SDATA "ū"--=small u, macron-->
<!ENTITY Umacr  SDATA "Ū"--=capital U, macron-->
<!ENTITY uogon  SDATA "ų"--=small u, ogonek-->
<!ENTITY Uogon  SDATA "Ų"--=capital U, ogonek-->
<!ENTITY uring  SDATA "ů"--=small u, ring-->
<!ENTITY Uring  SDATA "Ů"--=capital U, ring-->
<!ENTITY utilde SDATA "ũ"--=small u, tilde-->
<!ENTITY Utilde SDATA "Ũ"--=capital U, tilde-->
<!ENTITY wcirc  SDATA "ŵ"--=small w, circumflex accent-->
<!ENTITY Wcirc  SDATA "Ŵ"--=capital W, circumflex accent-->
<!ENTITY ycirc  SDATA "ŷ"--=small y, circumflex accent-->
<!ENTITY Ycirc  SDATA "Ŷ"--=capital Y, circumflex accent-->
<!ENTITY Yuml   SDATA "Ÿ"--=capital Y, dieresis or umlaut mark-->
<!ENTITY zacute SDATA "ź"--=small z, acute accent-->
<!ENTITY Zacute SDATA "Ź"--=capital Z, acute accent-->
<!ENTITY zcaron SDATA "ž"--=small z, caron-->
<!ENTITY Zcaron SDATA "Ž"--=capital Z, caron-->
<!ENTITY zdot   SDATA "ż"--=small z, dot above-->
<!ENTITY Zdot   SDATA "Ż"--=capital Z, dot above-->
 