      <div1 id="jg33019" type="&#xDC;berschrift1">
        <head><anchor id="gemeinschaftsprojekte"/>Gemeinschaftsprojekte</head>
        <p id="jg33020">
          <table>
            <row role="data">
              <cell role="data" rows="1" cols="1"><xref doc="JGOETHE8" from="id (FGA)">Aus dem Jahrgang 1772 der Frankfurter Gelehrten Anzeigen</xref><lb/>
