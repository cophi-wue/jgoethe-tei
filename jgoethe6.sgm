<ROW><CELL><XREF DOC="JGOETHE6" FROM="id (Lyrik)">Lyrik</XREF><LB><XREF DOC="JGOETHE6" FROM="id (AusdrucksfomenBrief)">Empfindsame Briefe - erdichtete und wirkliche</XREF><LB><XREF DOC="JGOETHE6" FROM="id (IdyllischesBukolisches)">Idyllisches, Bukolisches, Komisches</XREF><LB><XREF DOC="JGOETHE6" FROM="id (Tragisches)">Tragisches</XREF></TABLE>
