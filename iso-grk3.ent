<!-- Character entity set. Typical invocation:
     <!ENTITY % ISOgrk3 PUBLIC
       "ISO 8879-1986//ENTITIES Greek Symbols//EN">
     %ISOgrk3;
-->
<!ENTITY alpha    SDATA "&#945;"--=small alpha, Greek-->
<!ENTITY beta     SDATA "&#946;"--=small beta, Greek-->
<!ENTITY gamma    SDATA "&#947;"--=small gamma, Greek-->
<!ENTITY Gamma    SDATA "&#915;"--=capital Gamma, Greek-->
<!ENTITY gammad   SDATA "&#988;"--/digamma-->
<!ENTITY delta    SDATA "&#948;"--=small delta, Greek-->
<!ENTITY Delta    SDATA "&#916;"--=capital Delta, Greek-->
<!ENTITY epsi     SDATA "&#949;"--=small epsilon, Greek-->
<!ENTITY epsiv    SDATA "[epsiv ]"--/varepsilon-->
<!ENTITY epsis    SDATA "&#8714;"--/straightepsilon-->
<!ENTITY zeta     SDATA "&#950;"--=small zeta, Greek-->
<!ENTITY eta      SDATA "&#951;"--=small eta, Greek-->
<!ENTITY thetas   SDATA "&#952;"--straight theta-->
<!ENTITY Theta    SDATA "&#920;"--=capital Theta, Greek-->
<!ENTITY thetav   SDATA "&#977;"--/vartheta - curly or open theta-->
<!ENTITY iota     SDATA "&#953;"--=small iota, Greek-->
<!ENTITY kappa    SDATA "&#954;"--=small kappa, Greek-->
<!ENTITY kappav   SDATA "&#1008;"--/varkappa-->
<!ENTITY lambda   SDATA "&#955;"--=small lambda, Greek-->
<!ENTITY Lambda   SDATA "&#923;"--=capital Lambda, Greek-->
<!ENTITY mu       SDATA "&#956;"--=small mu, Greek-->
<!ENTITY nu       SDATA "&#957;"--=small nu, Greek-->
<!ENTITY xi       SDATA "&#958;"--=small xi, Greek-->
<!ENTITY Xi       SDATA "&#926;"--=capital Xi, Greek-->
<!ENTITY pi       SDATA "&#960;"--=small pi, Greek-->
<!ENTITY piv      SDATA "&#982;"--/varpi-->
<!ENTITY Pi       SDATA "&#928;"--=capital Pi, Greek-->
<!ENTITY rho      SDATA "&#961;"--=small rho, Greek-->
<!ENTITY rhov     SDATA "&#1009;"--/varrho-->
<!ENTITY sigma    SDATA "&#963;"--=small sigma, Greek-->
<!ENTITY Sigma    SDATA "&#931;"--=capital Sigma, Greek-->
<!ENTITY sigmav   SDATA "&#962;"--/varsigma-->
<!ENTITY tau      SDATA "&#964;"--=small tau, Greek-->
<!ENTITY upsi     SDATA "&#965;"--=small upsilon, Greek-->
<!ENTITY Upsi     SDATA "&#933;"--=capital Upsilon, Greek-->
<!ENTITY phis     SDATA "&#966;"--/straightphi - straight phi-->
<!ENTITY Phi      SDATA "&#934;"--=capital Phi, Greek-->
<!ENTITY phiv     SDATA "&#981;"--/varphi - curly or open phi-->
<!ENTITY chi      SDATA "&#967;"--=small chi, Greek-->
<!ENTITY psi      SDATA "&#968;"--=small psi, Greek-->
<!ENTITY Psi      SDATA "&#936;"--=capital Psi, Greek-->
<!ENTITY omega    SDATA "&#969;"--=small omega, Greek-->
<!ENTITY Omega    SDATA "&#937;"--=capital Omega, Greek-->
 