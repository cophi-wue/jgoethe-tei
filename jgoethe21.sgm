   <FILEDESC>
	<TITLESTMT>
		<TITLE>Der junge Goethe in seiner Zeit. Texte und Kontexte. </TITLE>		<AUTHOR>Johann Wolfgang Goethe</AUTHOR>
		<RESPSTMT>
			<RESP>Herausgegeben von </RESP>
