<!-- Character entity set. Typical invocation:
     <!ENTITY % ISOgrk1 PUBLIC
       "ISO 8879-1986//ENTITIES Greek Letters//EN">
     %ISOgrk1;
-->
<!ENTITY agr    SDATA "&#945;"--=small alpha, Greek-->
<!ENTITY Agr    SDATA "&#913;"--=capital Alpha, Greek-->
<!ENTITY bgr    SDATA "&#946;"--=small beta, Greek-->
<!ENTITY Bgr    SDATA "&#914;"--=capital Beta, Greek-->
<!ENTITY ggr    SDATA "&#947;"--=small gamma, Greek-->
<!ENTITY Ggr    SDATA "&#915;"--=capital Gamma, Greek-->
<!ENTITY dgr    SDATA "&#948;"--=small delta, Greek-->
<!ENTITY Dgr    SDATA "&#916;"--=capital Delta, Greek-->
<!ENTITY egr    SDATA "&#949;"--=small epsilon, Greek-->
<!ENTITY Egr    SDATA "&#917;"--=capital Epsilon, Greek-->
<!ENTITY zgr    SDATA "&#950;"--=small zeta, Greek-->
<!ENTITY Zgr    SDATA "&#918;"--=capital Zeta, Greek-->
<!ENTITY eegr   SDATA "&#951;"--=small eta, Greek-->
<!ENTITY EEgr   SDATA "&#919;"--=capital Eta, Greek-->
<!ENTITY thgr   SDATA "&#952;"--=small theta, Greek-->
<!ENTITY THgr   SDATA "&#920;"--=capital Theta, Greek-->
<!ENTITY igr    SDATA "&#953;"--=small iota, Greek-->
<!ENTITY Igr    SDATA "&#921;"--=capital Iota, Greek-->
<!ENTITY kgr    SDATA "&#954;"--=small kappa, Greek-->
<!ENTITY Kgr    SDATA "&#922;"--=capital Kappa, Greek-->
<!ENTITY lgr    SDATA "&#955;"--=small lambda, Greek-->
<!ENTITY Lgr    SDATA "&#923;"--=capital Lambda, Greek-->
<!ENTITY mgr    SDATA "&#956;"--=small mu, Greek-->
<!ENTITY Mgr    SDATA "&#924;"--=capital Mu, Greek-->
<!ENTITY ngr    SDATA "&#957;"--=small nu, Greek-->
<!ENTITY Ngr    SDATA "&#925;"--=capital Nu, Greek-->
<!ENTITY xgr    SDATA "&#958;"--=small xi, Greek-->
<!ENTITY Xgr    SDATA "&#926;"--=capital Xi, Greek-->
<!ENTITY ogr    SDATA "&#959;"--=small omicron, Greek-->
<!ENTITY Ogr    SDATA "&#927;"--=capital Omicron, Greek-->
<!ENTITY pgr    SDATA "&#960;"--=small pi, Greek-->
<!ENTITY Pgr    SDATA "&#928;"--=capital Pi, Greek-->
<!ENTITY rgr    SDATA "&#961;"--=small rho, Greek-->
<!ENTITY Rgr    SDATA "&#929;"--=capital Rho, Greek-->
<!ENTITY sgr    SDATA "&#963;"--=small sigma, Greek-->
<!ENTITY Sgr    SDATA "&#931;"--=capital Sigma, Greek-->
<!ENTITY sfgr   SDATA "&#962;"--=final small sigma, Greek-->
<!ENTITY tgr    SDATA "&#964;"--=small tau, Greek-->
<!ENTITY Tgr    SDATA "&#932;"--=capital Tau, Greek-->
<!ENTITY ugr    SDATA "&#965;"--=small upsilon, Greek-->
<!ENTITY Ugr    SDATA "&#933;"--=capital Upsilon, Greek-->
<!ENTITY phgr   SDATA "&#966;"--=small phi, Greek-->
<!ENTITY PHgr   SDATA "&#934;"--=capital Phi, Greek-->
<!ENTITY khgr   SDATA "&#967;"--=small chi, Greek-->
<!ENTITY KHgr   SDATA "&#935;"--=capital Chi, Greek-->
<!ENTITY psgr   SDATA "&#968;"--=small psi, Greek-->
<!ENTITY PSgr   SDATA "&#936;"--=capital Psi, Greek-->
<!ENTITY ohgr   SDATA "&#969;"--=small omega, Greek-->
<!ENTITY OHgr   SDATA "&#937;"--=capital Omega, Greek-->
 