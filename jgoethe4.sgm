FROM="id (CAGN)">III,17</XREF> Jaxthaussen.<LB><XREF DOC="JGOETHE4" FROM="id (CAHN)">III,18</XREF> Belagerung. K&uuml;che.<LB><XREF DOC="JGOETHE4" FROM="id (CAIN)">III,19</XREF> Saal.<LB><XREF DOC="JGOETHE4" FROM="id (CBXN)">III,20</XREF> Saal.<LB><XREF DOC="JGOETHE4" FROM="id (CBAN)">III,21</XREF> 
[Schlosshof]<LB><XREF DOC="JGOETHE4" FROM="id (CBBN)">III,22</XREF> Saal.<LB><LB> <LB> Vierter Act<LB><LB><XREF DOC="JGOETHE4" FROM="id (DAN)">IV,1</XREF> Wirthshaus zu Heilbronn.<LB><XREF DOC="JGOETHE4" FROM="id (DBN)">IV,2</XREF> Rathhaus.<LB><XREF DOC="JGOETHE4" FROM="id (DCN)">IV,3</XREF> 
